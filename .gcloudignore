# This file specifies files and directories to ignore when uploading source code to Google Cloud Build.
.gcloudignore
.git
.gitignore

# Node dependencies
**/node_modules/

# Python virtual environments
**/.venv/
**/__pycache__/
**/*.pyc

# Angular build outputs
**/dist/
**/.angular/

# Local environment files
**/.env
**/.env.local
**/.env.development

# Terraform caches, state, plans, and generated tfvars
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfvars
**/*.tfvars.json
**/tfplan
*.cstudio_bootstrap.conf
cstudio_profiles/

# Local development & review artifacts
notebooks
experiments
genmedia-agent-demos
_review/
downloads/
screenshots/
.gemini/
.agents/
